# Placeholders only — never commit real values.
# Run scripts/dev-env.sh to generate a local .env with random secrets.
APP_ENV=development
PUBLIC_APP_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
# true everywhere except plain-http localhost
SECURE_COOKIES=false
TRUSTED_PROXY_HOPS=1

DATABASE_HOST=localhost
DATABASE_PORT=5432
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=replace_me
CATALOG_DB_USER=catalog_svc
CATALOG_DB_PASSWORD=replace_me
INVENTORY_DB_USER=inventory_svc
INVENTORY_DB_PASSWORD=replace_me
CART_DB_USER=cart_svc
CART_DB_PASSWORD=replace_me
CHECKOUT_DB_USER=checkout_svc
CHECKOUT_DB_PASSWORD=replace_me
ORDERS_DB_USER=orders_svc
ORDERS_DB_PASSWORD=replace_me
COD_DB_USER=cod_svc
COD_DB_PASSWORD=replace_me
PAYMENTS_DB_USER=payments_svc
PAYMENTS_DB_PASSWORD=replace_me
NOTIFICATIONS_DB_USER=notifications_svc
NOTIFICATIONS_DB_PASSWORD=replace_me

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=replace_me
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=aurelia
RABBITMQ_PASSWORD=replace_me

# Service-to-service credentials (32+ chars, must differ). Interim until mTLS / workload identity.
GATEWAY_INTERNAL_TOKEN=replace_with_32_plus_random_chars
SERVICE_INTERNAL_TOKEN=replace_with_32_plus_random_chars
CHECKOUT_QUOTE_SECRET=replace_with_32_plus_random_chars
COD_PHONE_PEPPER=replace_with_32_plus_random_chars

# Razorpay — TEST MODE ONLY. payment-service refuses live keys and any mode other than "test".
RAZORPAY_ENABLED=false
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=replace_with_test_key_id
RAZORPAY_KEY_SECRET=replace_with_secret_from_secret_manager
RAZORPAY_WEBHOOK_SECRET=replace_with_webhook_secret

# Business configuration
BULK_MINIMUM_UNITS=10
BULK_ALLOW_MIXED_SKUS=true
COD_FEE_PAISE=4900
COD_MAX_ORDER_VALUE_PAISE=2500000
COD_ALLOW_BULK=false

# Storefront (server-side only; never expose secrets via NEXT_PUBLIC_*)
GATEWAY_URL=http://localhost:8080
