{
  "$description": "Aurelia design tokens. Text colours meet WCAG 2.2 AA (>= 4.5:1) on ivory; gold and rose are decorative only.",
  "color": {
    "ivory":      { "value": "#F8F5EF", "use": "page background" },
    "ivoryDeep":  { "value": "#EFE8DC", "use": "panels, image wells" },
    "gold":       { "value": "#C5A46D", "use": "decorative accents, rules, icons (not body text)" },
    "goldDeep":   { "value": "#7A5B23", "use": "accent text on ivory (5.9:1)" },
    "plum":       { "value": "#352433", "use": "primary actions, headings (13.4:1)" },
    "plumSoft":   { "value": "#4A3447", "use": "hover state for plum" },
    "charcoal":   { "value": "#242124", "use": "body text (15.2:1)" },
    "muted":      { "value": "#5E5560", "use": "secondary text (6.6:1)" },
    "rose":       { "value": "#D7B6AE", "use": "decorative washes" },
    "line":       { "value": "#E3DACB", "use": "hairlines, borders" },
    "success":    { "value": "#2F6B4F" },
    "danger":     { "value": "#A12F35" }
  },
  "font": {
    "serif": "Cormorant Garamond — editorial headings",
    "sans": "Manrope — UI and body"
  },
  "radius": { "sm": "4px", "md": "10px", "lg": "18px" },
  "motion": { "durationFast": "150ms", "durationBase": "300ms", "easing": "cubic-bezier(.2,.7,.2,1)", "respectReducedMotion": true }
}
